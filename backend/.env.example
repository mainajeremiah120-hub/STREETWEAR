# Copy this file to .env and fill in your values

# Port the API runs on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/streetwear
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/streetwear
MONGO_URI=mongodb://127.0.0.1:27017/streetwear

# Where the frontend runs (for CORS)
CLIENT_URL=http://localhost:5173

# Gmail account used to send order confirmation emails.
# EMAIL_APP_PASSWORD is NOT your normal Gmail password — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
# If left blank, order confirmation emails are just skipped (order still succeeds).
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=

# Where "new order" alerts get sent to you. Optional — if left blank, alerts
# go to EMAIL_USER above (i.e. you don't need to set this at all normally).
OWNER_EMAIL=

# JWT auth for the admin dashboard. Generate JWT_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Bootstrap admin account — auto-created on first server start if no Admin
# document exists yet. Change the password from the dashboard Settings page
# after your first login; these vars are only read while no admin exists.
ADMIN_EMAIL=admin@kirijopharmacy.co.ke
ADMIN_PASSWORD=change-this-password
