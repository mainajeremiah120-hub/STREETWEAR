# Base URL of the KIRIJO PHARMACY backend API
VITE_API_URL=http://localhost:5000/api

# Cloudinary unsigned upload, used by the admin product form's image picker.
# Create a free account, then an UNSIGNED upload preset at:
# https://cloudinary.com/console/settings/upload
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
